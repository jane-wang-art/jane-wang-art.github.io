<% const series = site.data.gallery.series; const count = series.reduce(function(n,s){return n+s.pages.length},0); %>
<section class="wrap page-intro"><p class="eyebrow">THE GALLERY</p><h1>日子里的<span class="rose-word">小画面。</span></h1><p>可以慢慢看，也可以点开一张，放大看看。</p><div class="collection-meta"><span class="pill">生活漫画</span><span><%= series.length %> 个故事</span><span><%= count %> 张作品</span></div></section>
<% series.forEach(function(story){ %><section class="wrap gallery-section"><div class="section-heading"><div><h2><%= story.title %></h2><p><%= story.english_title %></p></div><a class="text-link" href="<%= url_for(story.path) %>">按顺序读故事 →</a></div><div class="art-grid"><% story.pages.forEach(function(art){ %><%- partial('_partial/card',{story:story,art:art}) %><% }); %></div></section><% }); %>
<p class="gallery-credit wrap">Artwork by Jane Wang · 原始作品见 <a href="<%= config.artwork_repository %>">GitHub 作品仓库 ↗</a><br>公开欣赏不等于免费使用，<a href="<%= url_for('/licensing/') %>">转载前请先取得授权</a>。</p>
