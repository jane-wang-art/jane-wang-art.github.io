<% const story = site.data.gallery.series.find(function(s){return s.id === page.gallery_key}); %>
<article class="story-article"><header class="wrap story-header"><a class="back-link" href="<%= url_for('/archives/') %>">← 所有故事</a><p class="eyebrow">ILLUSTRATED DAYS / 生活漫画</p><h1><%= page.title %></h1><p class="story-summary"><%= page.description || '' %></p><div class="story-byline"><span>Artwork by Jane Wang</span><time datetime="<%= date(page.date,'YYYY-MM-DD') %>"><%= date(page.date,'YYYY.MM.DD') %> · 博客发布</time><% if(story){ %><span><%= story.pages.length %> 张漫画</span><% } %></div></header>
<% if(story){ %><nav class="reader-nav" aria-label="漫画页码"><div><span class="reader-label"><%= story.title %></span><div class="page-jumps"><% story.pages.forEach(function(art){ %><a href="#page-<%= art.id %>" aria-label="跳到第 <%= art.id %> 张"><%= art.id %></a><% }); %></div><span class="reader-progress">01 / <%= String(story.pages.length).padStart(2,'0') %></span></div></nav><div class="reader"><p class="reader-tip">往下翻，一张一张看。点击画面可放大。</p><% story.pages.forEach(function(art,i){ %><figure class="comic-page" id="page-<%= art.id %>"><figcaption><span><%= art.id %> / <%= String(story.pages.length).padStart(2,'0') %></span><span><%= art.title %></span></figcaption><a href="<%= url_for('/images/' + story.id + '/' + art.id + '.png') %>" data-lightbox data-caption="<%= story.title %> · <%= art.id %> / <%= String(story.pages.length).padStart(2,'0') %> · <%= art.title %>" data-alt="<%= art.alt %>"><img src="<%= url_for('/images/' + story.id + '/' + art.id + '-1122.webp') %>" width="1122" height="1402" loading="<%= i ? 'lazy' : 'eager' %>" decoding="async" alt="<%= art.alt %>"></a><small>Artwork by Jane Wang</small></figure><% }); %></div><div class="story-end wrap"><span aria-hidden="true">✳</span><p>这一篇，画到这里。</p><a class="button" href="<%= url_for('/gallery/') %>">回画廊再逛逛 →</a><a class="text-link" href="<%= config.artwork_repository %>/tree/main/stories/001-autumn-terrace">原图与版本记录 ↗</a></div>
<% } else { %><div class="prose wrap"><%- page.content %></div><% } %>
<aside class="reader-rights wrap">作品作者 Jane Wang · © 2026 jane-wang-art。<a href="<%= url_for('/licensing/') %>">转载与使用请先取得授权</a>。</aside></article>
